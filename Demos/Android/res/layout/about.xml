<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101318"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="TEECHART FOR ANDROID"
            android:textColor="#7895F5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:text="Powerful charting.\nMade for Android."
            android:textColor="#F3F4F6"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/editText1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5dp"
            android:text="@string/about"
            android:textColor="#B7C0CE"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp"
            android:text="EXPLORE STEEMA"
            android:textColor="#F3F4F6"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/linkWebsite"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/demo_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/demo_link_icon">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="⌂" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="22sp" />
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:contentDescription="" android:src="@drawable/about_home" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Steema website" android:textColor="#F3F4F6" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="www.steema.com" android:textColor="#A5ADBA" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↗" android:textColor="#7895F5" android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linkGithub"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/demo_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/demo_link_icon">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:contentDescription="" android:src="@drawable/github_mark" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GitHub" android:textColor="#F3F4F6" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Steema / TeeChartJava" android:textColor="#A5ADBA" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↗" android:textColor="#7895F5" android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linkX"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/demo_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/demo_link_icon" android:gravity="center" android:text="X" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="X" android:textColor="#F3F4F6" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@SteemaSoftware" android:textColor="#A5ADBA" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↗" android:textColor="#7895F5" android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linkLinkedin"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/demo_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/demo_link_icon" android:gravity="center" android:text="in" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LinkedIn" android:textColor="#F3F4F6" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Steema Software" android:textColor="#A5ADBA" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↗" android:textColor="#7895F5" android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linkYoutube"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/demo_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">
            <TextView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/demo_link_icon" android:gravity="center" android:text="▶" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="YouTube" android:textColor="#F3F4F6" android:textSize="15sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Steema channel" android:textColor="#A5ADBA" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↗" android:textColor="#7895F5" android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Steema Software · Charting since 1995"
            android:textColor="#737F91"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
