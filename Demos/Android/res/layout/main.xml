            <TextView android:layout_height="wrap_content" android:id="@+id/label1" android:layout_width="wrap_content" android:text=" "></TextView>
            <TextView android:layout_height="wrap_content" android:id="@+id/label2" android:layout_width="wrap_content" android:text=" "></TextView>
