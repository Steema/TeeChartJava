<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/rgThemes">
    <RadioButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Opera"
        android:layout_margin="3dp"
        android:id="@+id/rbtOpera"
        android:tag="0"/>
    <RadioButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Black is Back"
        android:tag="1"
        android:layout_margin="3dp"
        android:id="@+id/rbtBlackIsBack"/>
    <RadioButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TeeChart"
        android:tag="2"
        android:layout_margin="3dp"
        android:id="@+id/rbtTeechart"/>
    <RadioButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Excel"
        android:tag="3"
        android:layout_margin="3dp"
        android:id="@+id/rbtExcel"/>
    <RadioButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Classic"
        android:tag="4"
        android:layout_margin="3dp"
        android:id="@+id/rbtClassic"/>
    <RadioButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="XP"
        android:tag="5"
        android:layout_margin="3dp"
        android:id="@+id/rbtXP"/>
    <RadioButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Web"
        android:tag="6"
        android:layout_margin="3dp"
        android:id="@+id/rbtWeb"/>
    <RadioButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Business"
        android:tag="7"
        android:layout_margin="3dp"
        android:id="@+id/rbtBusiness"/>
    <RadioButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Blues"
        android:tag="8"
        android:layout_margin="3dp"
        android:id="@+id/rbtBlues"/>
    <RadioButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="9"
        android:text="GrayScale"
        android:layout_margin="3dp"
        android:id="@+id/rbtGrayScale"/>
    <RadioButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="10"
        android:text="Flat"
        android:layout_margin="3dp"
        android:id="@+id/rbtFlat"/>
    <RadioButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="11"
        android:text="Lookout"
        android:layout_margin="3dp"
        android:id="@+id/rbtLookout"/>
    <RadioButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Andros"
        android:tag="12"
        android:layout_margin="3dp"
        android:id="@+id/rbtAndros"/>
    <RadioButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Report"
        android:tag="13"
        android:layout_margin="3dp"
        android:id="@+id/rbtReport"/>
    </RadioGroup>

    </LinearLayout>
    </ScrollView>
</LinearLayout>