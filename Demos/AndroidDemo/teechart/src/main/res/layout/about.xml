<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="TEECHART FOR ANDROID"
            android:textColor="?attr/colorAccent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="Powerful charting. Made for Android."
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/editText1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="@string/tvAboutSteema"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:text="EXPLORE STEEMA"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/linkWebsite"
            style="@style/AboutLinkRow">
            <TextView style="@style/AboutLinkIcon" android:text="⌂" />
            <LinearLayout style="@style/AboutLinkText">
                <TextView style="@style/AboutLinkTitle" android:text="Steema website" />
                <TextView style="@style/AboutLinkSubtitle" android:text="www.steema.com" />
            </LinearLayout>
            <TextView style="@style/AboutLinkArrow" android:text="↗" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linkGithub"
            style="@style/AboutLinkRow">
            <ImageView
                style="@style/AboutLinkIconImage"
                android:contentDescription="GitHub"
                android:src="@drawable/github_mark" />
            <LinearLayout style="@style/AboutLinkText">
                <TextView style="@style/AboutLinkTitle" android:text="GitHub" />
                <TextView style="@style/AboutLinkSubtitle" android:text="Steema / TeeChartJava" />
            </LinearLayout>
            <TextView style="@style/AboutLinkArrow" android:text="↗" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linkX"
            style="@style/AboutLinkRow">
            <TextView style="@style/AboutLinkIcon" android:text="X" />
            <LinearLayout style="@style/AboutLinkText">
                <TextView style="@style/AboutLinkTitle" android:text="X" />
                <TextView style="@style/AboutLinkSubtitle" android:text="@SteemaSoftware" />
            </LinearLayout>
            <TextView style="@style/AboutLinkArrow" android:text="↗" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linkLinkedin"
            style="@style/AboutLinkRow">
            <TextView style="@style/AboutLinkIcon" android:text="in" />
            <LinearLayout style="@style/AboutLinkText">
                <TextView style="@style/AboutLinkTitle" android:text="LinkedIn" />
                <TextView style="@style/AboutLinkSubtitle" android:text="Steema Software" />
            </LinearLayout>
            <TextView style="@style/AboutLinkArrow" android:text="↗" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linkYoutube"
            style="@style/AboutLinkRow">
            <TextView style="@style/AboutLinkIcon" android:text="▶" />
            <LinearLayout style="@style/AboutLinkText">
                <TextView style="@style/AboutLinkTitle" android:text="YouTube" />
                <TextView style="@style/AboutLinkSubtitle" android:text="Steema channel" />
            </LinearLayout>
            <TextView style="@style/AboutLinkArrow" android:text="↗" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Steema Software · Charting since 1995"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
