* text=auto
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.shp binary
*.shx binary
# Preserve the exact library source/resource bytes on every checkout.
# -text disables newline conversion, not textual diffs for Java/properties.
Sources/**/src/** -text
Sources/Android/res/** -text
Sources/Android/assets/** -text
